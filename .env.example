# Application
APP_NAME="Travel Journal API"
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Local ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
PGADMIN_PORT=5050

# Postgres and pgAdmin
POSTGRES_DB=travel_journal
POSTGRES_USER=travel_journal
POSTGRES_PASSWORD=travel_journal
DATABASE_URL=postgresql+asyncpg://travel_journal:travel_journal@localhost:5432/travel_journal
PGADMIN_DEFAULT_EMAIL=admin@traveljournal.dev
PGADMIN_DEFAULT_PASSWORD=admin

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_OPERATION_TIMEOUT_SECONDS=5
READINESS_TIMEOUT_SECONDS=2

# Durable generation worker. Redis carries wake-up IDs; Postgres owns job state.
GENERATION_QUEUE_KEY=travel-journal:generation:queued
GENERATION_MAX_ATTEMPTS=3
GENERATION_RETRY_BASE_SECONDS=5
WORKER_NAME=generation-worker
WORKER_POLL_SECONDS=2
WORKER_HEARTBEAT_KEY=travel-journal:generation:worker:heartbeat
WORKER_HEARTBEAT_SECONDS=5
WORKER_HEARTBEAT_TTL_SECONDS=15
WORKER_RECONCILE_SECONDS=5
WORKER_LEASE_SECONDS=60

# Frontend -> backend. BACKEND_URL is server-side; NEXT_PUBLIC_* is browser-visible.
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# External providers (server-only; the scaffold starts without these keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_SECONDS=120
PROVIDER_CONTEXT_MAX_CHARS=30000
CALA_API_KEY=
CALA_BASE_URL=https://api.cala.ai
CALA_TIMEOUT_SECONDS=30
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/schnell
FAL_START_TIMEOUT_SECONDS=30
FAL_RESULT_TIMEOUT_SECONDS=180

# Generated journal images are copied from fal into app-owned storage.
MEDIA_STORAGE_PATH=.data/generated-media
MEDIA_URL_PATH=/media
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=30
MEDIA_MAX_BYTES=15000000
